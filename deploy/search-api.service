[Unit]
Description=Search HTTP API (agent0 serve) — /search and /health, fronted by nginx
Documentation=https://github.com/agent-native-search
After=network-online.target
Wants=network-online.target
# Order after the index-owning agent service when both run on one host.
After=search-agent.service

[Service]
Type=simple
User=search
Group=search
WorkingDirectory=/opt/search
Environment=SEARCH_DATA_DIR=/var/lib/search
# 8080 is taken by code-server on the current host, so the API binds 8090 and nginx proxies to it.
Environment=SEARCH_BIND=127.0.0.1:8090
Environment=RUST_LOG=info
ExecStart=/opt/search/bin/agent0 serve
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/search
LimitNOFILE=65536

# The service user must OWN the data root: the metadata store is SQLite in WAL mode and is opened
# read-write even for serving, so a read-only grant fails at startup with
# "Failed to acquire Lockfile: IoError(PermissionDenied)" and the unit restart-loops.
#   useradd --system --no-create-home --shell /usr/sbin/nologin search
#   chown -R search:search /var/lib/search

[Install]
WantedBy=multi-user.target
